FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=your-secret-key-here
HOST=0.0.0.0
PORT=5000
DATABASE_URL=sqlite:///database/smart_bus.db
# DATABASE_URL=postgresql://user:password@localhost:5432/smart_bus_db
SIMULATION_ENABLED=True
SIMULATION_INTERVAL=2.0
SIMULATED_BUS_COUNT=4
OVERCROWDING_THRESHOLD_WARN=0.80
OVERCROWDING_THRESHOLD_CRITICAL=1.00
SPEED_LIMIT_KMH=65.0
TEMP_LIMIT_HIGH_CELSIUS=95.0
BATTERY_VOLTAGE_MIN=11.4
MQTT_BROKER=broker.hivemq.com
MQTT_PORT=1883
MQTT_TELEMETRY_TOPIC=smartbus/esp32/telemetry
MQTT_COMMAND_TOPIC=smartbus/esp32/command
